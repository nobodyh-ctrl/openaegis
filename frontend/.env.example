# Copiá este archivo a .env.local (ignorado por git) y completá con TU API.
# Solo para desarrollo: el proxy de Vite reenvía /api/* a esta URL (docs/08-frontend.md §2.4).
API_PROXY_TARGET=https://<api-id>.execute-api.us-east-1.amazonaws.com

# Cognito (Etapa 9). No son secretos (quedan visibles en el .js), pero son IDs de TU cuenta: no van al repo.
# Emisor de los tokens: de acá oidc-client-ts lee la configuración OIDC y las claves públicas (JWKS).
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
# App client público (sin secret): Cognito → User pools → App clients.
VITE_COGNITO_CLIENT_ID=<client-id>
# Dominio del login de Cognito, para el logout (Cognito no lo publica en su configuración OIDC).
VITE_COGNITO_DOMAIN=https://<dominio-cognito>
